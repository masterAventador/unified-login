{
  "name": "@unified-login/admin-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build:sdk": "pnpm --dir ../sdk/web-ts build",
    "dev": "pnpm run build:sdk && vite --force",
    "build": "pnpm run build:sdk && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "pnpm run build:sdk && tsc --noEmit"
  },
  "dependencies": {
    "@unified-login/web": "link:../sdk/web-ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "7.3.6",
    "vitest": "4.0.17"
  }
}
