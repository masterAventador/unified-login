{
  "name": "@unified-login/demo-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:sdk": "tsc -p ../../sdk/tauri/tsconfig.build.json && node ../../sdk/tauri/scripts/normalize-source-map.mjs",
    "build": "pnpm run build:sdk && tsc -b && vite build",
    "dev": "pnpm run build:sdk && vite",
    "test": "vitest run",
    "test:acceptance:unit": "node tests/run-acceptance-unit.mjs",
    "test:acceptance:headless": "node tests/headless-production-acceptance.mjs",
    "typecheck": "pnpm run build:sdk && tsc --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@unified-login/tauri": "file:../../sdk/tauri"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tauri-apps/cli": "2.11.4",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.17"
  }
}
