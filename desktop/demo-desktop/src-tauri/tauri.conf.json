{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "统一登录桌面端",
  "version": "0.1.0",
  "identifier": "com.aventador.unified-login.demo-desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "统一登录桌面端",
        "width": 960,
        "height": 680,
        "minWidth": 640,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "通过系统浏览器安全登录"
  }
}
